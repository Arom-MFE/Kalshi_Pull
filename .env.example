# Optional. Every endpoint this repo calls answers without a key today.
# These two values are read only if an endpoint answers 401 or 403; the same
# request is then sent again with signed headers.
KALSHI_API_KEY_ID=your-api-key-id-here
KALSHI_KEY_PATH=/Users/yourname/.kalshi/kalshi_key.pem

# Not read from this file: KALSHI_DATA_DIR (data root) and KALSHI_MAX_RPS
# (request rate cap) come from the process environment only, for example
#   KALSHI_DATA_DIR=/tmp/kalshi_scratch python -m pull_historical.pull_daily --tickers KXFED
